# Copy these values into your hosting provider's Environment Variables.
# For local development only, you can copy this file to .env.local.

# Google Sheets Integration
# 1. Create a Google Cloud project -> enable Google Sheets API
# 2. Create a service account -> download JSON key
# 3. Share the target spreadsheet with the service account email (Editor role)

GOOGLE_SHEETS_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Drive CV upload
# Parent folder URL example: https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-cv-parent-folder-id
# Optional: set these if you want to target subfolders by ID instead of by name.
GOOGLE_DRIVE_FOLDER_DEV_AI_ID=your-dev-devops-ai-folder-id
GOOGLE_DRIVE_FOLDER_INFRA_ID=your-infras-folder-id
GOOGLE_DRIVE_FOLDER_MKT_SALES_ID=your-mkt-sales-folder-id
GOOGLE_DRIVE_ONBOARDING_FOLDER_ID=your-company-intro-folder-id
GOOGLE_DRIVE_SEND_NOTIFICATION_EMAIL=false

# Candidate confirmation email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@your-domain.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM_NAME=Markee Recruitment
MAIL_FROM_EMAIL=hello@your-domain.com
MAIL_SUBJECT_PREFIX=
ZALO_COMMUNITY_URL=https://zalo.me/g/your-group
# Optional override. If blank, email uses GOOGLE_DRIVE_ONBOARDING_FOLDER_ID.
ONBOARDING_VIDEO_URL=

# Telegram recruitment notifications
# Bot must be added to each target group. Use negative supergroup IDs, e.g. -1001234567890.
# If the target is a Telegram forum topic, also set the matching THREAD_ID.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_MESSAGE_PREFIX=
TELEGRAM_CHAT_DEV_AI_ID=your-dev-ai-group-chat-id
TELEGRAM_CHAT_DEV_AI_THREAD_ID=
TELEGRAM_CHAT_INFRA_ID=your-infra-group-chat-id
TELEGRAM_CHAT_INFRA_THREAD_ID=
TELEGRAM_CHAT_MKT_SALES_ID=your-mkt-sales-group-chat-id
TELEGRAM_CHAT_MKT_SALES_THREAD_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App secrets
ADMIN_API_KEY=replace-with-a-long-random-secret
# Optional: set this separately; otherwise ADMIN_API_KEY is used as CSRF secret.
CSRF_SECRET=replace-with-a-long-random-secret
